# Kopiera den här filen till .env.local och fyll i värdena från Firebase.
# (Firebase Console → Project settings → "Your apps" → Web app → Config)

NEXT_PUBLIC_FIREBASE_API_KEY=din-api-nyckel
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ditt-projekt.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ditt-projekt
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ditt-projekt.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# För push-notiser (se NOTISER-GUIDE.md):
NEXT_PUBLIC_FIREBASE_VAPID_KEY=din-vapid-nyckel
# OBS: FIREBASE_SERVICE_ACCOUNT läggs bara in i Vercel, inte här
