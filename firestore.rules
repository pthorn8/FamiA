// firestore.rules
// Klistra in dessa i Firebase Console → Firestore → Rules.
// De ser till att bara inloggade medlemmar kommer åt sin egen familjs data.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Användarprofiler
    match /users/{userId} {
      // Inloggade får läsa andra användares profil (för att visa namn/bild)
      allow read: if request.auth != null;
      // Bara du själv får ändra din egen profil
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Familjer
    match /families/{familyId} {
      // Vem som helst inloggad får läsa (behövs för att hitta familj via inbjudningskod)
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // Bara medlemmar (eller någon som lägger till sig själv) får uppdatera
      allow update: if request.auth != null &&
        (request.auth.uid in resource.data.memberIds ||
         request.auth.uid in request.resource.data.memberIds);

      // Underliggande data (listor, händelser, aktivitet): bara medlemmar
      match /{sub=**} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.memberIds;
      }
    }
  }
}
